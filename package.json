{
  "name": "movealong",
  "version": "0.1.0",
  "private": true,
  "description": "MoveAlong — second-hand marketplace for movers with map discovery + AI room visualization",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "node --test tests/movealong.test.mjs",
    "verify": "npm test && npx tsc --noEmit && npm run build",
    "postinstall": "prisma generate || true"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "next": "14.2.34",
    "uuid": "^11.0.3",
    "zod": "^3.23.8",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.34",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1"
  }
}
