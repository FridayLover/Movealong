# MoveAlong — copy to .env and adjust
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string-32chars-min"

# ── AI (Meta Muse Image is the publishable Meta path) ──
# Meta Model API: https://api.meta.ai/v1  model=muse-image-1.0  (~$0.01/image)
# Get a key in https://dev.meta.ai/ → Model API dashboard (MODEL_API_KEY / META_API_KEY)
# Supports multiple input_image references → fuses room + 1-8 furniture images into one photoreal scene.
# Leave blank to use instant on-device canvas mock (always works, no key needed).
META_API_KEY=""
MODEL_API_KEY=""
META_MODEL_API_KEY=""
# Fallback provider (SDXL interior inpainting) — if set and Meta fails/absent, we try Replicate
REPLICATE_API_TOKEN=""
REPLICATE_MODEL_VERSION=""

# ── AI concierge (Meta Muse Spark, text + reasoning) ──
# Model: muse-spark-1.3 via the same Meta Model API (POST https://api.meta.ai/v1/responses)
# Uses META_API_KEY/MODEL_API_KEY above. Leave blank = deterministic local concierge (still works, labels itself "local").
AGENT_MODEL="muse-spark-1.3"

# Optional — for handover to Stripe when you go paid
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Map — Leaflet uses OpenStreetMap, no key needed. If you switch to Mapbox:
NEXT_PUBLIC_MAPBOX_TOKEN=""
