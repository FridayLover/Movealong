generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  passwordHash     String
  name             String
  avatar           String?
  coverImage       String?
  tagline          String?
  pronouns         String?
  languages        String?  // JSON array, e.g. ["English","Thai"]
  accent           String?  @default("terracotta") // terracotta | sage | slate | rose | ochre | forest
  pickupBadges     String?  // JSON array, e.g. ["elevator","evenings"]
  showcaseIds      String?  // JSON array of listing ids in curated order
  prefDistanceKm   Float?   @default(10)
  prefBudgetMax    Float?
  prefCategories   String?  // JSON array of category ids
  prefStyle        String?  // e.g. cozy | minimal | scandi | warm-modern
  phone            String?
  building         String?
  address          String?
  lat              Float?
  lng              Float?
  bio              String?
  credits          Int          @default(3)
  creditsUsedThisMonth Int     @default(0)
  lastCreditReset  DateTime     @default(now())
  subscriptionTier String       @default("free") // free | plus | pro
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  listings         Listing[]
  favorites        Favorite[]
  cartItems        CartItem[]
  rooms            Room[]
  generations      Generation[]
  savedSearches    SavedSearch[]
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  messagesSent     Message[]
  agentMessages    AgentMessage[]
  ordersAsBuyer    Order[] @relation("BuyerOrders")
  ordersAsSeller   Order[] @relation("SellerOrders")
  transactions     Transaction[]
}

model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // furniture | appliance | decor | kitchen | electronics | other
  condition   String   // new | like_new | good | fair | poor
  price       Float?   // null or 0 = free
  originalPrice Float? // retail price when new — powers "% saved vs new" (price is king in resale stats)
  moveOutDate String?  // YYYY-MM-DD must-go-by for movers — powers urgency badge
  pickupNote  String?  // e.g. "Lobby, evenings after 18:00"
  isFree      Boolean  @default(false)
  images      String   // JSON array of base64/urls
  width       Float?
  height      Float?
  depth       Float?
  unit        String?  // cm | inch
  building    String?
  address     String?
  lat         Float?
  lng         Float?
  status      String   @default("available") // available | reserved | sold
  delivery    String   @default("pickup") // pickup | self_delivery | both
  views       Int      @default(0)
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  favorites   Favorite[]
  cartItems   CartItem[]
  generations Generation[]
  conversations Conversation[]
  orders      Order[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])
  @@unique([userId, listingId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])
  @@unique([userId, listingId])
}

model Room {
  id         String      @id @default(cuid())
  userId     String
  name       String
  image      String     // base64 data URL or URL
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt
  user       User        @relation(fields: [userId], references: [id])
  generations Generation[]
}

model Generation {
  id         String   @id @default(cuid())
  userId     String
  listingId  String   // primary / first item (kept for compat)
  listingIds String   @default("[]") // JSON array of all listing ids in scene
  roomId     String?
  roomImage  String   // base64 or url snapshot used
  resultImage String? // base64 data URL or remote URL
  prompt     String?
  provider   String   @default("mock-canvas")
  creditsUsed Int     @default(1)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  listing    Listing  @relation(fields: [listingId], references: [id])
  room       Room?    @relation(fields: [roomId], references: [id])
}

model Conversation {
  id        String    @id @default(cuid())
  listingId String?
  buyerId   String
  sellerId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  listing   Listing?  @relation(fields: [listingId], references: [id])
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  seller    User      @relation("SellerConversations", fields: [sellerId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
}

model Order {
  id            String   @id @default(cuid())
  buyerId       String
  sellerId      String
  listingId     String
  price         Float    // snapshot at checkout (0 for FREE)
  paymentMethod String   // card | pickup
  status        String   @default("pending_pickup") // pending_pickup | paid | completed
  createdAt     DateTime @default(now())
  buyer         User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller        User     @relation("SellerOrders", fields: [sellerId], references: [id])
  listing       Listing  @relation(fields: [listingId], references: [id])
}

model AgentMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // user | assistant
  body      String
  meta      String?  // JSON: recommended ids, draftListing, draftReply, preferences used
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String?  // free-text q
  category  String   @default("all")
  building  String?
  maxPrice  Float?
  freeOnly  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  type      String   // purchase | subscription | generation
  amount    Int      // credits
  price     Float?   // USD
  meta      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
